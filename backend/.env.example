# FastAPI Supabase Configuration

# URL de votre projet Supabase (ex: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-supabase-project-url.supabase.co

# Clé anonyme ou Service Role Key
SUPABASE_KEY=your-supabase-anon-key

# Clé secrète JWT Supabase (optionnel, pour vérification locale des tokens si besoin)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Configuration CORS (origine du frontend)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
